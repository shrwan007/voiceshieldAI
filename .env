# ── Database ───────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://voiceshield:voiceshield_pass@localhost:5432/voiceshield_db

# ── Application ────────────────────────────────────────────────────────────────
SECRET_KEY=voiceshield-dev-secret-key-change-in-production-32chars
DEBUG=true

# ── CORS ───────────────────────────────────────────────────────────────────────
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# ── Model Settings ─────────────────────────────────────────────────────────────
DETECTION_MODEL=speechbrain/aasist-spoof-detection
SPEAKER_MODEL=speechbrain/spkrec-ecapa-voxceleb
DEVICE=cpu

# ── Storage ────────────────────────────────────────────────────────────────────
AUDIO_STORAGE_PATH=audio_storage
MODELS_CACHE_PATH=models_cache
